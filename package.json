{
  "name": "react-scalable-toggle",
  "version": "0.0.0",
  "description": "A React switch component that scales proportionally from one height value.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/style.css",
    "./src/ScalableToggle.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --css",
    "typecheck": "tsc --noEmit",
    "dev": "vite demo --host 127.0.0.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "keywords": [
    "react",
    "toggle",
    "switch",
    "scalable",
    "accessible",
    "component"
  ],
  "license": "MIT"
}
